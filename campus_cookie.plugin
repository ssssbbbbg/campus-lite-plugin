#!name=campus-lite 会话抓取
#!desc=拦截 *.confong.cn 请求抠出 cookie2 复制到剪贴板
#!author=minis

[MITM]
hostname = *.confong.cn
enable = true
skip-server-cert-verify = true

[Script]
http-request ^https?://[^/]*\.?confong\.cn/ script-path=https://raw.githubusercontent.com/ssssbbbbg/campus-lite-plugin/main/campus_cookie.js, tag=抓confong会话, timeout=30, enable=true
