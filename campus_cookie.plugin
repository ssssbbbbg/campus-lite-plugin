#!name = campus-lite 会话抓取
#!desc = 拦截 confong.cn 请求，抠出 cookie2 复制到剪贴板
#!author = minis

[General]
real-ip = *.confong.cn

[Mitm]
hostname = *.confong.cn

[Script]
request if ${url} ~= /^https?:\/\/[^/]*\.?confong\.cn\// then script("https://raw.githubusercontent.com/ssssbbbbg/campus-lite-plugin/main/campus_cookie.js") with tag = "抓confong会话"
